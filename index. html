
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prince World</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f0f2f5;font-family:Arial,sans-serif}
header{background:#1877f2;color:white;padding:18px;text-align:center;font-size:25px;font-weight:bold}
nav{background:white;padding:14px;text-align:center}
nav a{margin:10px;color:#1877f2;text-decoration:none;font-weight:bold}
.container{max-width:600px;margin:20px auto;padding:10px}
.post{background:white;padding:20px;margin:15px 0;border-radius:10px;box-shadow:0 2px 6px #ccc}
button{background:#1877f2;color:white;border:0;padding:10px 18px;border-radius:6px}
input{width:100%;padding:12px;border:1px solid #ccc;border-radius:7px;margin:8px 0}
</style>
</head>
<body>
<header>👑 Prince World</header>
<nav>
<a href="#">Home</a>
<a href="#">Friends</a>
<a href="#">Profile</a>
</nav>
<div class="container">
<div class="post">
<h2>Welcome to Prince World!</h2>
<p>তোমার নিজের Social Media Platform ❤️</p>
</div>
<div class="post">
<h3>Create a Post</h3>
<input id="postText" placeholder="তুমি কী ভাবছো?">
<button onclick="addPost()">Post করুন</button>
</div>
<div id="posts">
<div class="post">
<h3>Prince World 👑</h3>
<p>আমাদের নতুন Social Media Website-এ স্বাগতম!</p>
</div>
</div>
</div>
<script>
function addPost(){
let t=document.getElementById('postText');
if(!t.value.trim())return;
let p=document.createElement('div');
p.className='post';
p.textContent=t.value;
document.getElementById('posts').prepend(p);
t.value='';
}
</script>
</body>
</html>
